{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Financial Quote",
  "description": "One row = one financial quote (exchange rate, security price, bank/insurance stock, interest/premium) in one issue",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "quote_id": { "type": "string", "description": "Unique identifier for this quote" },
      "price_list_id": { "type": "string", "description": "Groups quotes from the same price list in the same issue (shared with goods_prices table)" },
      "source_dataset": { "type": "string", "description": "e.g., 'price_currents_pages' or 'price_currents_blocks'" },
      "filename": { "type": "string", "description": "Source filename, e.g., 'sn83030007_1788-12-12_1.pdf'" },
      "newspaper_id": { "type": "string", "description": "Chronicling America newspaper ID" },
      "newspaper_title": { "type": "string", "description": "Full newspaper title" },
      "page_number": { "type": "integer", "description": "Page number in the issue" },
      "block_id": { "type": "string", "description": "Block ID from blocks dataset (e.g., '/page/1/Table/33')" },
      "block_type": { "type": "string", "description": "Block type (Table, SectionHeader, Text, etc.)" },
      "issue_date": { "type": "string", "format": "date", "description": "From filename, YYYY-MM-DD" },
      "year": { "type": "integer", "description": "Year extracted from issue_date" },
      "price_date_stated": { "type": "string", "format": "date", "description": "Date stated in the quote if different from issue_date" },
      "publication_city": { "type": "string" },
      "publication_state": { "type": "string" },
      "publication_lat": { "type": "number" },
      "publication_lon": { "type": "number" },
      "region": { "type": "string", "enum": ["New England", "Middle", "South", "Other"], "description": "Region of publication" },
      "market_place": { "type": "string", "description": "Market named in the heading (e.g., 'PRICE CURRENT IN PHILADELPHIA'). Can differ from publication place." },
      "quote_kind": { "type": "string", "enum": ["exchange_rate", "public_security", "bank_stock", "insurance_stock", "interest_or_premium", "other"], "description": "Kind of financial quote" },
      "instrument_as_printed": { "type": "string", "description": "Instrument name exactly as printed (e.g., 'Spanish Milled Dollars', '6 per Cents', 'Bank Stock')" },
      "instrument_normalized": { "type": "string", "description": "Normalized instrument name (e.g., 'Spanish Milled Dollar', 'US 6% Bond', 'Bank of US Stock')" },
      "quote_as_printed": { "type": "string", "description": "Full quote text exactly as printed (e.g., 'Spanish Milled Dollars 4/8', '6 per Cents 17 3/4 pr. £. or 37 1/2 per cent.')" },
      "quote_low_as_printed": { "type": "string", "description": "Low end of quote range exactly as printed" },
      "quote_high_as_printed": { "type": "string", "description": "High end of quote range exactly as printed" },
      "quote_low_value": { "type": "number", "description": "Low value in main unit (numeric, if parseable)" },
      "quote_high_value": { "type": "number", "description": "High value in main unit (numeric, if parseable)" },
      "quote_basis": { "type": "string", "enum": ["percent_of_par", "percent_premium", "percent_discount", "currency_per_currency", "price_per_share", "unclear", "other"], "description": "Basis of the quote" },
      "from_currency": { "type": "string", "description": "Source currency for exchange rates (e.g., 'Spanish Milled Dollar')" },
      "to_currency": { "type": "string", "description": "Target currency for exchange rates (e.g., 'Sterling', 'South Carolina Currency')" },
      "terms": { "type": "string", "description": "Terms or conditions (e.g., 'par', 'premium', 'discount', 'advance')" },
      "raw_text": { "type": "string", "description": "Original OCR text for this quote" },
      "parse_method": { "type": "string", "enum": ["regex", "table_parse", "llm", "manual"], "description": "How this row was parsed" },
      "confidence": { "type": "string", "enum": ["high", "medium", "low"], "description": "Confidence in the parse" },
      "needs_review": { "type": "boolean", "description": "Flag for OCR issues or uncertainty" },
      "review_reason": { "type": "string", "description": "Reason for review flag" },
      "interpretation_note": { "type": "string", "description": "Arithmetic, conversions and interpretations; only when the text supports it" }
    },
    "required": [
      "quote_id", "price_list_id", "source_dataset", "filename", "newspaper_id",
      "page_number", "issue_date", "year",
      "instrument_as_printed", "quote_as_printed", "quote_kind", "market_place",
      "parse_method", "confidence"
    ],
    "additionalProperties": false
  },
