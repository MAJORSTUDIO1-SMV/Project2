{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Price Observation",
  "description": "One row = one item's price in one price list in one issue",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "observation_id": { "type": "string", "description": "Unique identifier for this observation" },
      "price_list_id": { "type": "string", "description": "Groups rows from the same price list in the same issue" },
      "source_dataset": { "type": "string", "description": "e.g., 'price_currents_pages' or 'price_currents_blocks'" },
      "block_id": { "type": "string", "description": "Block ID from blocks dataset (e.g., '/page/1/Table/33')" },
      "block_type": { "type": "string", "description": "Block type (Table, SectionHeader, Text, etc.)" },
      "filename": { "type": "string", "description": "Source filename, e.g., 'sn83021126_1775-01-02_1.pdf'" },
      "newspaper_id": { "type": "string", "description": "Chronicling America newspaper ID" },
      "newspaper_title": { "type": "string", "description": "Full newspaper title" },
      "page_number": { "type": "integer", "description": "Page number in the issue" },
      "ocr_run_id": { "type": "string", "description": "OCR run identifier (e.g., VLM_OCR_1)" },
      "page_url": { "type": "string", "description": "URL to the page image" },
      "raw_text": { "type": "string", "description": "Original OCR text for this row" },

      "issue_date": { "type": "string", "format": "date", "description": "From filename, YYYY-MM-DD" },
      "year": { "type": "integer", "description": "Year extracted from issue_date" },
      "price_date_stated": { "type": "string", "format": "date", "description": "Date stated in the price notice if different from issue_date" },
      "repeated_notice": { "type": "boolean", "description": "True if this notice repeats an older published date" },

      "publication_city": { "type": "string" },
      "publication_state": { "type": "string" },
      "publication_lat": { "type": "number" },
      "publication_lon": { "type": "number" },
      "region": { "type": "string", "enum": ["New England", "Middle", "South", "Other"], "description": "Region of publication" },
      "within_13_colonies": { "type": "boolean", "description": "Whether publication was within the 13 colonies/states" },
      "market_place": { "type": "string", "description": "Market named in the heading (e.g., 'PRICE CURRENT IN PHILADELPHIA'). Can differ from publication place (e.g., 'Price current at Liverpool' means market is Liverpool, but publication may be New York)." },

      "item_as_printed": { "type": "string", "description": "Item name exactly as printed" },
      "item_normalized": { "type": "string", "description": "Normalized item name" },
      "item_category": { "type": "string", "enum": ["grain", "flour_bread", "meat", "dairy", "drink", "fuel", "textile", "colonial_goods", "tobacco", "metals", "naval_stores", "other"], "description": "Category of the item" },
      "item_qualifier": { "type": "string", "description": "Qualifiers like 'prime', 'common', 'superfine'" },
      "in_basket": { "type": "boolean", "description": "Whether item is in a standard price basket" },

      "unit_as_printed": { "type": "string", "description": "Unit exactly as printed" },
      "unit_normalized": { "type": "string", "enum": ["bbl", "bu", "lb", "gal", "cwt", "keg", "bolt", "loaf"], "description": "Normalized unit" },
      "unit_quantity": { "type": "number", "description": "Quantity of the unit (e.g., 100 for 'per hund.')" },
      "unit_status": { "type": "string", "enum": ["printed", "not_stated", "inferred", "ditto_of_previous"], "description": "Whether unit appears in text (printed), is missing (not_stated), was inferred (inferred), or same as previous item (ditto_of_previous)" },
      "unit_inferred": { "type": "string", "description": "Inferred unit if unit_status is inferred; otherwise null" },
      "unit_inference_basis": { "type": "string", "description": "Reason for inference if unit_status is inferred; otherwise null" },
      "plausibility_flag": { "type": "boolean", "description": "True if price is far out of line with others in same table or newspaper" },

      "price_low_as_printed": { "type": "string", "description": "Low price exactly as printed (e.g., '5 50')" },
      "price_high_as_printed": { "type": "string", "description": "High price exactly as printed (e.g., '6')" },
      "price_low_value": { "type": "number", "description": "Low price in main unit (dollars, or decimal pounds for L.s.d.)" },
      "price_high_value": { "type": "number", "description": "High price in main unit (dollars, or decimal pounds for L.s.d.)" },
      "price_low_pounds": { "type": "integer", "description": "Pounds component of low price (for L.s.d.)" },
      "price_low_shillings": { "type": "integer", "description": "Shillings component of low price (for L.s.d.)" },
      "price_low_pence": { "type": "integer", "description": "Pence component of low price (for L.s.d.)" },
      "price_high_pounds": { "type": "integer", "description": "Pounds component of high price (for L.s.d.)" },
      "price_high_shillings": { "type": "integer", "description": "Shillings component of high price (for L.s.d.)" },
      "price_high_pence": { "type": "integer", "description": "Pence component of high price (for L.s.d.)" },
      "price_scale": { "type": "string", "enum": ["dollars_cents", "cents", "pounds_shillings_pence", "shillings", "coppers", "unknown"], "description": "Scale of the price" },
      "currency_as_printed": { "type": "string", "description": "Currency as printed (e.g., 'D. C.', 'L. s. d.', 'cents')" },
      "currency_basis": { "type": "string", "enum": ["paper", "specie", "unknown"], "description": "Paper money or specie" },
      "price_type": { "type": "string", "enum": ["market", "assize", "asking", "wholesale", "retail", "unknown"], "description": "Type of price" },
      "row_kind": { "type": "string", "enum": ["goods_price", "assize"], "description": "Kind of price row: goods_price for market prices, assize for regulated prices. Financial quotes go in financial_quotes table." },
      "availability_note": { "type": "string", "description": "Notes like 'scarce', 'plenty'" },
      "remark": { "type": "string", "description": "Any other remarks" },
      "interpretation_note": { "type": "string", "description": "Arithmetic, conversions and interpretations; only when the text supports it" },

      "layout_type": { "type": "string", "enum": ["inline_text", "column_table", "html_table", "assize_notice", "other"], "description": "Layout of the price table" },
      "parse_method": { "type": "string", "enum": ["regex", "table_parse", "llm", "manual"], "description": "How this row was parsed" },
      "confidence": { "type": "string", "enum": ["high", "medium", "low"], "description": "Confidence in the parse" },
      "needs_review": { "type": "boolean", "description": "Flag for OCR issues or uncertainty" },
      "review_reason": { "type": "string", "description": "Reason for review flag" }
    },
    "required": [
      "observation_id", "price_list_id", "source_dataset", "block_id", "block_type",
      "filename", "newspaper_id", "page_number", "ocr_run_id", "raw_text", "issue_date", "year",
      "item_as_printed", "item_normalized", "item_category",
      "unit_as_printed", "price_low_as_printed", "price_high_as_printed",
      "price_low_value", "price_high_value", "price_scale", "currency_as_printed",
      "row_kind", "layout_type", "parse_method", "confidence"
    ],
    "additionalProperties": false
  },
